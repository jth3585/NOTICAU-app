{
  "expo": {
    "name": "NOTICAU",
    "slug": "noticau",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#2850A7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.noticau.app",
      "buildNumber": "15",
      "usesAppleSignIn": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2850A7",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#ffffff"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "공지 마감일을 캘린더에 추가하기 위해 캘린더 접근이 필요합니다."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "c9517a88-bd0f-445b-b9dc-3d280691f69b"
      }
    },
    "owner": "jooth"
  }
}
